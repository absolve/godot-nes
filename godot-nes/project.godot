; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot-nes"
config/description="用 Godot 4 (.NET / C#) 实现的 NES 模拟器"
run/main_scene="res://scene/main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

UiSettings="*res://autoload/ui_settings.gd"
InputConfig="*res://autoload/input_config.gd"
EmulatorService="*res://autoload/EmulatorService.cs"
DebugHub="*res://autoload/debug_hub.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="godot-nes"

[gui]

theme/custom="res://theme/dark_theme.tres"

