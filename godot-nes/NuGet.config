<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot 的 .NET 包（Godot.NET.Sdk / GodotSharp / Godot.SourceGenerators / GodotSharpEditor）
  随 Godot 编辑器一起分发在 <Godot 安装目录>\GodotSharp\Tools\nupkgs 下。
  这里把它注册成 NuGet 源，这样在离线（或无法访问 nuget.org）的机器上也能 restore / build。

  如果以后本项目需要引用 nuget.org 上的第三方包，把下面注释掉的源打开即可。

  也可以用环境变量 GODOT_MONO_DIR 指向 Godot .NET 版安装目录来替换硬编码路径。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-bundled-local" value="E:\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
    <!--
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    -->
  </packageSources>
</configuration>
