<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!--
      目标框架说明：
      Godot 4.7.2 的 .NET 绑定（GodotSharp.dll）本身面向 net8.0，而 Godot 启动 CoreCLR 时
      用的是 GodotPlugins.runtimeconfig.json（tfm=net8.0, rollForward=LatestMajor）。
      本机安装的运行时是 7.0 / 9.0 / 10.x，没有 8.0，也没有 net8.0 的 targeting pack，
      因此这里编译到 net10.0，运行时会由 LatestMajor 滚动到已安装的 10.x。
      如果以后换到装有 .NET 8 SDK 的机器，把它改回 net8.0 即可，其余代码不用动。
    -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- 程序集名必须与 project.godot 里 [dotnet] project/assembly_name 一致 -->
    <RootNamespace>GodotNes</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 模拟器热路径会用 Span / stackalloc / MemoryMarshal -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests/ 只放测试 ROM 与说明，不参与编译 -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
